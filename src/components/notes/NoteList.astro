---
import type { CollectionEntry } from "astro:content";
import Tags from "../Tags.astro";
import FormattedDate from "../FormattedDate.astro";
import Categories from "../Categories.astro";
import { getNoteExcerpt } from "../../lib/notes";
import { notes } from "../../data/notes";

interface Props {
  posts: CollectionEntry<"blog">[];
  title: string;
  selectedCategory?: string;
  searchable?: boolean;
  showCategories?: boolean;
}
const { posts, title, selectedCategory, searchable = false, showCategories = true } = Astro.props;
let previousYear: number | undefined;
---

<h1 class="mb-9 border-b border-note-line pb-7 font-paper-serif text-3xl font-medium leading-relaxed sm:mb-10 sm:text-4xl">
  {title}
</h1>
<slot name="controls" />
<div
  data-search-results={searchable ? "true" : undefined}
  hidden={searchable}
  class:list={[
    "grid items-start gap-10",
    showCategories && "lg:grid-cols-[minmax(0,1fr)_200px] lg:gap-14",
  ]}
>
  <section aria-label="文章列表" class="min-w-0">
    {posts.map((post) => {
      const date = post.data.update ?? post.data.date;
      const year = date.getUTCFullYear();
      const newYear = year !== previousYear;
      previousYear = year;
      return (
        <>
          {newYear && (
            <h2
              data-search-year={searchable ? String(year) : undefined}
              class="mt-5 mb-4 font-display text-3xl leading-normal text-note-muted italic first:mt-0"
            >
              {year} <span aria-hidden="true">—</span>
            </h2>
          )}
          <article
            data-search-title={searchable ? post.data.title : undefined}
            data-search-year={searchable ? String(year) : undefined}
            class="grid grid-cols-[3rem_minmax(0,1fr)] gap-3 py-5 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:gap-4 sm:py-6"
          >
            <FormattedDate
              {date}
              type="short"
              className="pt-2 font-display text-base text-note-muted italic sm:text-lg"
            />
            <div class="min-w-0 border-l border-note-line pl-4 sm:pl-6">
              <Tags tags={post.data.tags} />
              <h3 class="mt-1 mb-3 font-paper-serif text-xl leading-relaxed font-medium">
                <a
                  data-search-title-link={searchable ? "true" : undefined}
                  href={`/blog/${post.id}/`}
                  class="hover:text-note-accent hover:opacity-100"
                >
                  {post.data.title}
                </a>
              </h3>
              <p class="line-clamp-3 text-sm leading-loose text-note-muted">
                {getNoteExcerpt(post.body)}
              </p>
            </div>
          </article>
        </>
      );
    })}
    <slot />
  </section>
  {showCategories && (
    <aside class="hidden lg:block">
      <Categories selected={selectedCategory} />
    </aside>
  )}
</div>
{showCategories && (
  <details class="mt-10 border-t border-note-line pt-4 lg:hidden">
    <summary class="cursor-pointer py-3 text-sm text-note-muted">{notes.categories}</summary>
    <div class="mt-3">
      <Categories selected={selectedCategory} />
    </div>
  </details>
)}
