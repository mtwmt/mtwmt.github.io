---
import { notes } from "../data/notes";
---

<p class="mb-5 text-sm font-medium text-note-ink">{notes.comments}</p>
<div id="blog-comments"></div>

<script>
  function commentTheme(): string {
    return document.documentElement.classList.contains("dark") ? "github-dark" : "github-light";
  }

  function initComments(): void {
    const container = document.getElementById("blog-comments");
    if (!container || container.dataset.initialized) return;
    container.dataset.initialized = "true";
    const script = document.createElement("script");
    script.src = "https://utteranc.es/client.js";
    script.async = true;
    script.setAttribute("repo", "mtwmt/mtwmt.github.io");
    script.setAttribute("issue-term", "pathname");
    script.setAttribute("theme", commentTheme());
    script.setAttribute("crossorigin", "anonymous");
    container.append(script);
  }

  document.addEventListener("astro:page-load", initComments);
  document.addEventListener("theme:change", () => {
    const frame = document.querySelector<HTMLIFrameElement>("#blog-comments iframe");
    frame?.contentWindow?.postMessage(
      { type: "set-theme", theme: commentTheme() },
      "https://utteranc.es",
    );
  });
</script>
