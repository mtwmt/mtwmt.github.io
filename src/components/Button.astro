---
import type { HTMLAttributes } from "astro/types";

/** 筆記版型的按鈕；有 href 時輸出連結，否則輸出 <button>。 */
type Props = {
  variant?: "primary" | "outline" | "ghost";
  size?: "sm" | "md";
  href?: string;
} & Omit<HTMLAttributes<"button">, "class"> &
  Pick<HTMLAttributes<"a">, "target" | "rel"> & { class?: string };

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  disabled = false,
  class: className,
  target,
  rel,
  ...rest
} = Astro.props;

const variantClasses = {
  primary: "border-note-ink bg-note-ink text-note-paper hover:bg-note-ink/90",
  outline: "border-note-line text-note-ink hover:bg-note-soft",
  ghost: "border-transparent text-note-ink hover:bg-note-soft",
};
const sizeClasses = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-base",
};
const classes = [
  "inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-sm border font-medium transition-colors disabled:cursor-wait disabled:opacity-60",
  variantClasses[variant],
  sizeClasses[size],
  className,
];
---

{href ? (
  <a href={href} target={target} rel={rel} class:list={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} disabled={disabled} class:list={classes} {...rest}>
    <slot />
  </button>
)}
