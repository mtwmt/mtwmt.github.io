---
import { Icon } from "astro-icon/components";
---

<button
  type="button"
  data-theme-toggle
  aria-label="切換深色模式"
  aria-pressed="false"
  class="grid size-11 cursor-pointer place-items-center rounded-full border border-note-line transition-colors hover:bg-note-paper"
>
  <Icon name="ic:outline-dark-mode" class="size-4.5 dark:hidden" />
  <Icon name="ic:outline-light-mode" class="hidden size-4.5 dark:block" />
</button>

<script>
  function updateThemeControls(): void {
    const dark = document.documentElement.classList.contains("dark");
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      button.setAttribute("aria-pressed", String(dark));
      button.setAttribute("aria-label", dark ? "切換淺色模式" : "切換深色模式");
    }
  }

  function initTheme(): void {
    updateThemeControls();
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      if (button.dataset.initialized) continue;
      button.dataset.initialized = "true";
      button.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", dark ? "dark" : "light");
        } catch {}
        updateThemeControls();
        document.dispatchEvent(new Event("theme:change"));
      });
    }
  }

  document.addEventListener("astro:page-load", initTheme);
</script>
