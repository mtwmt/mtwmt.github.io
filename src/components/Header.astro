---
import { Icon } from "astro-icon/components";
import Theme from "./Theme.astro";
import Brand from "./Brand.astro";
import { notes } from "../data/notes";

const { pathname } = Astro.url;
const isSearch = pathname.startsWith("/search");
const isBlog = pathname.startsWith("/blog");
---

<header class="border-b border-note-line/50 bg-note-ground">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-5 sm:px-9 sm:py-6">
    <Brand />
    <nav aria-label="主要導覽" class="flex items-center gap-4 text-xs sm:gap-6">
      <a
        href="/blog/page/1/"
        aria-current={isBlog ? "page" : undefined}
        class:list={["py-2 hover:text-note-accent", isBlog && "border-b border-note-accent"]}
      >
        {notes.title}
      </a>
      <a
        href="/search/"
        aria-label="搜尋筆記"
        aria-current={isSearch ? "page" : undefined}
        class:list={["grid size-10 place-items-center sm:size-11", isSearch && "text-note-accent"]}
      >
        <Icon name="ic:outline-search" class="size-5" />
      </a>
      <!-- 首頁是全螢幕 3D，需要完整載入，不走 ClientRouter。 -->
      <a href="/" data-astro-reload class="hidden hover:text-note-accent sm:inline">
        {notes.home} →
      </a>
      <Theme />
    </nav>
  </div>
</header>
