---
import type { MarkdownHeading } from "astro";
import TocLinks from "./TocLinks.astro";
import { notes } from "../data/notes";

interface Props {
  headings: MarkdownHeading[];
  /** 手機版：收在文章開頭的折疊選單；桌機版：側欄固定導覽。 */
  mobile?: boolean;
}
const { headings, mobile = false } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const title = notes.toc;
---

{toc.length > 0 &&
  (mobile ? (
    <details data-mobile-toc class="mb-8 border-y border-note-line py-1 lg:hidden">
      <summary class="cursor-pointer py-3 text-sm text-note-muted">{title}</summary>
      <nav data-toc aria-label={title} class="pb-3">
        <TocLinks headings={toc} mobile />
      </nav>
    </details>
  ) : (
    <nav
      data-toc
      aria-label={title}
      class="sticky top-8 max-h-[calc(100svh-4rem)] overflow-y-auto text-xs"
    >
      <h2 class="mb-4 text-sm font-medium">{title}</h2>
      <TocLinks headings={toc} />
    </nav>
  ))}

<script>
  let cleanup: (() => void) | undefined;

  function initToc(): void {
    cleanup?.();
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
    const headings = [
      ...new Set(
        links
          .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
          .filter((heading): heading is HTMLElement => heading !== null),
      ),
    ];
    if (!headings.length) return;
    const controller = new AbortController();
    let frame: number | undefined;

    function setCurrent(id: string): void {
      for (const link of links) {
        if (decodeURIComponent(link.hash.slice(1)) === id)
          link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    }

    function updateCurrent(): void {
      // 共用桌面與手機的章節起點；長段落中仍保留目前所在章節。
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= 140) current = heading;
        else break;
      }
      setCurrent(current.id);
      frame = undefined;
    }

    function onScroll(): void {
      if (frame === undefined) frame = requestAnimationFrame(updateCurrent);
    }

    for (const link of links) {
      link.addEventListener(
        "click",
        () => {
          setCurrent(decodeURIComponent(link.hash.slice(1)));
          const details = link.closest<HTMLDetailsElement>("[data-mobile-toc]");
          if (details) details.open = false;
        },
        { signal: controller.signal },
      );
    }
    updateCurrent();
    window.addEventListener("scroll", onScroll, { passive: true, signal: controller.signal });
    cleanup = () => {
      controller.abort();
      if (frame !== undefined) cancelAnimationFrame(frame);
    };
  }

  document.addEventListener("astro:page-load", initToc);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
