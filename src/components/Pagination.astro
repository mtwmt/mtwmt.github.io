---
interface Props {
  path?: string;
  page: { currentPage: number; lastPage: number; url: { prev?: string; next?: string } };
}
const { page, path = "/blog/page" } = Astro.props;
const basePath = path.replace(/\/$/, "");
// 靜態網站使用目錄路徑，統一尾斜線以避免 ClientRouter 遇到重新導向。
const previousUrl = page.url.prev ? `${basePath}/${page.currentPage - 1}/` : undefined;
const nextUrl = page.url.next ? `${basePath}/${page.currentPage + 1}/` : undefined;
const start = Math.max(1, Math.min(page.currentPage - 2, page.lastPage - 4));
const pages = Array.from({ length: Math.min(5, page.lastPage) }, (_, index) => start + index);
---

{page.lastPage > 1 && (
  <nav
    aria-label="文章分頁"
    class="mt-10 flex flex-wrap items-center gap-1 border-t border-note-line pt-5 text-sm"
  >
    {previousUrl && (
      <a
        href={previousUrl}
        aria-label="上一頁"
        class="grid size-11 place-items-center rounded-sm text-note-muted hover:bg-note-soft"
      >
        ←
      </a>
    )}
    {start > 1 && (
      <>
        <a href={`${basePath}/1/`} class="grid size-11 place-items-center hover:bg-note-soft">
          1
        </a>
        {start > 2 && <span class="px-1 text-note-muted">…</span>}
      </>
    )}
    {pages.map((number) => (
      <a
        href={`${basePath}/${number}/`}
        aria-current={number === page.currentPage ? "page" : undefined}
        class:list={[
          "grid size-11 place-items-center rounded-sm",
          number === page.currentPage
            ? "bg-note-ink text-note-paper hover:opacity-100"
            : "text-note-muted hover:bg-note-soft",
        ]}
      >
        {number}
      </a>
    ))}
    {pages[pages.length - 1] < page.lastPage && (
      <>
        {pages[pages.length - 1] < page.lastPage - 1 && <span class="px-1 text-note-muted">…</span>}
        <a
          href={`${basePath}/${page.lastPage}/`}
          class="grid size-11 place-items-center hover:bg-note-soft"
        >
          {page.lastPage}
        </a>
      </>
    )}
    {nextUrl && (
      <a
        href={nextUrl}
        aria-label="下一頁"
        class="grid size-11 place-items-center rounded-sm text-note-muted hover:bg-note-soft"
      >
        →
      </a>
    )}
  </nav>
)}
