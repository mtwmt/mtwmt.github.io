---
interface Props {
  tags?: string[];
}
const { tags = [] } = Astro.props;
---

<div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-note-accent">
  {tags.map((tag) => (
    <a
      href={`/blog/tags/${encodeURIComponent(tag.toLowerCase())}/`}
      class="inline-flex min-h-9 items-center underline-offset-4 hover:underline"
    >
      {tag}
    </a>
  ))}
</div>
