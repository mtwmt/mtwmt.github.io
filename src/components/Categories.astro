---
import { getCollection } from "astro:content";
import CategoryLinks from "./CategoryLinks.astro";
import { notes } from "../data/notes";

interface Props {
  selected?: string;
}
const { selected } = Astro.props;
const posts = await getCollection("blog");
const counts = new Map<string, { name: string; count: number }>();
for (const post of posts) {
  for (const name of post.data.categories ?? []) {
    const key = name.toLowerCase();
    const existing = counts.get(key);
    counts.set(key, { name: existing?.name ?? name, count: (existing?.count ?? 0) + 1 });
  }
}
const categories = [...counts]
  .map(([slug, category]) => ({ slug, ...category }))
  .sort((a, b) => b.count - a.count);
---

<nav aria-label={notes.categories} class="relative rounded-sm bg-note-soft p-5 text-sm lg:p-6">
  <span
    aria-hidden="true"
    class="absolute -top-1.5 right-5 h-7 w-4 bg-note-accent [clip-path:polygon(0_0,100%_0,100%_100%,50%_78%,0_100%)]"
  ></span>
  <h2 class="mb-3 text-sm font-medium">{notes.categories}</h2>
  <a
    href="/blog/page/1/"
    aria-current={!selected ? "page" : undefined}
    class="flex min-h-11 items-center text-note-muted hover:text-note-accent"
  >
    {notes.all}
  </a>
  <CategoryLinks categories={categories.slice(0, 8)} {selected} />
  {categories.length > 8 && (
    <details class="mt-3 border-t border-note-line pt-3">
      <summary class="min-h-11 cursor-pointer py-2 text-xs text-note-muted">更多分類</summary>
      <CategoryLinks categories={categories.slice(8)} {selected} />
    </details>
  )}
  <a
    href="/blog/tags/"
    class="mt-4 block border-t border-note-line pt-4 text-xs text-note-muted hover:text-note-accent"
  >
    {notes.series} ↗
  </a>
</nav>
