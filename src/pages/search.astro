---
import { getCollection } from "astro:content";
import NotesLayout from "../layouts/NotesLayout.astro";
import NoteList from "../components/notes/NoteList.astro";
import SearchWidget from "../components/SearchWidget.astro";
import { search } from "../data/search";
import { sortByDate } from "../lib/sortByDate";

const posts = sortByDate(await getCollection("blog"));
---

<NotesLayout title={search.title} description={search.description} noindex>
  <NoteList {posts} title={search.title} searchable showCategories={false}>
    <SearchWidget slot="controls" />
  </NoteList>
</NotesLayout>
