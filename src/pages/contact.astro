---
import NotesLayout from "../layouts/NotesLayout.astro";
import Button from "../components/Button.astro";
import FormField from "../components/notes/FormField.astro";
import { contact } from "../data/site";
import { contactPage } from "../data/contactPage";
---

<NotesLayout title={contactPage.title} description={contactPage.description}>
  <h1 class="mb-9 border-b border-note-line pb-7 font-paper-serif text-3xl leading-relaxed font-medium sm:mb-10 sm:text-4xl">
    {contactPage.title}
  </h1>

  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-14">
    <section aria-labelledby="contact-form-title" class="min-w-0">
      <p class="text-sm leading-loose text-note-muted">{contactPage.description}</p>
      <h2 id="contact-form-title" class="mt-8 font-paper-serif text-xl font-medium">
        {contactPage.formTitle}
      </h2>
      <p class="mt-2 text-xs text-note-muted">{contactPage.formHint}</p>

      <!-- 有 JavaScript 時改用 fetch 送出並顯示結果；沒有時表單直接送到 action。 -->
      <form
        data-contact-form
        action={contact.formEndpoint}
        method="post"
        class="mt-6 grid gap-6 sm:grid-cols-2"
        data-sending-label={contactPage.sending}
        data-success-label={contactPage.success}
        data-failure-label={contactPage.failure}
      >
        <FormField
          label="姓名"
          name="name"
          placeholder="請輸入您的姓名"
          autocomplete="name"
          required
        />
        <FormField
          label="電話"
          name="tel"
          type="tel"
          placeholder="0912-345-678"
          autocomplete="tel"
        />
        <FormField
          label="電子信箱"
          name="email"
          type="email"
          placeholder="your@email.com"
          autocomplete="email"
          required
        />
        <FormField label="LINE ID" name="line" placeholder="請輸入您的 LINE ID" />
        <FormField
          class="sm:col-span-2"
          label="訊息內容"
          name="message"
          multiline
          placeholder="想跟 Mandy 說些什麼？例如：專案需求、合作提案、技術諮詢等…"
          required
        />
        <div class="flex flex-wrap items-center justify-between gap-4 sm:col-span-2">
          <p data-contact-status role="status" class="text-sm text-note-muted"></p>
          <Button type="submit" class="px-6">
            {contactPage.submit}
          </Button>
        </div>
      </form>
    </section>

    <aside class="border-t border-note-line pt-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
      <h2 class="font-paper-serif text-lg font-medium">{contactPage.otherWays}</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a href={`mailto:${contact.email}`} class="break-all hover:text-note-accent">
            {contact.email}
          </a>
        </li>
        <li>
          <a
            href={contact.github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-note-accent"
          >
            GitHub ↗
          </a>
        </li>
      </ul>
    </aside>
  </div>
</NotesLayout>

<script>
  // ClientRouter 換頁後也要綁定；dataset 避免同一個表單重複綁定。
  function initContactForm(): void {
    const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
    const status = document.querySelector<HTMLElement>("[data-contact-status]");
    if (!form || !status || form.dataset.ready) return;
    form.dataset.ready = "true";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const originalLabel = submit?.textContent ?? "";
      if (submit) {
        submit.disabled = true;
        submit.textContent = form.dataset.sendingLabel ?? "";
      }
      status.textContent = "";

      try {
        await fetch(form.action, { method: "POST", body: new FormData(form) });
        status.textContent = form.dataset.successLabel ?? "";
        form.reset();
      } catch (error) {
        console.error("聯絡表單送出失敗：", error);
        status.textContent = form.dataset.failureLabel ?? "";
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = originalLabel;
        }
      }
    });
  }

  initContactForm();
  document.addEventListener("astro:page-load", initContactForm);
</script>
