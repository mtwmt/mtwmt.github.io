---
import NotesLayout from "../layouts/NotesLayout.astro";
import Button from "../components/Button.astro";
import { notFound } from "../data/notFound";
import NotFoundCharacter from "../components/island/NotFoundCharacter.astro";
---

<NotesLayout title={notFound.title} description={notFound.description} noindex>
  <section
    aria-labelledby="not-found-title"
    class="mx-auto flex max-w-3xl flex-col items-center py-4 text-center sm:py-8"
  >
    <div class="flex items-end justify-center">
      <p class="mb-10 font-display text-7xl leading-none text-note-accent sm:mb-14 sm:text-[10rem]">
        404
      </p>
      <NotFoundCharacter />
    </div>
    <h1
      id="not-found-title"
      class="mt-4 font-paper-serif text-3xl leading-relaxed font-medium sm:text-4xl"
    >
      {notFound.title}
    </h1>
    <p class="mt-4 max-w-md text-sm leading-loose text-balance text-note-muted">
      {notFound.description}
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <Button size="sm" href="/blog/page/1/">
        {notFound.notes}
      </Button>
      <Button variant="outline" size="sm" href="/" data-astro-reload>
        {notFound.home} →
      </Button>
    </div>
    <a
      href="/search/"
      class="mt-5 inline-flex min-h-11 items-center text-sm text-note-muted hover:text-note-accent"
    >
      {notFound.search} →
    </a>
  </section>
</NotesLayout>
