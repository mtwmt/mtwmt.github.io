---
import { getCollection, type CollectionEntry } from "astro:content";
import NotesLayout from "../../../layouts/NotesLayout.astro";
import NoteList from "../../../components/notes/NoteList.astro";
import { sortByDate } from "../../../lib/sortByDate";
import { describeNotes } from "../../../lib/notes";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const categories = new Map<string, string>();
  for (const post of posts) {
    for (const category of post.data.categories ?? [])
      categories.set(category.toLowerCase(), category);
  }
  return [...categories].map(([slug, category]) => ({
    params: { slug },
    props: {
      category,
      posts: sortByDate(
        posts.filter((post) =>
          (post.data.categories ?? []).some((name) => name.toLowerCase() === slug),
        ),
      ),
    },
  }));
}

interface Props {
  posts: CollectionEntry<"blog">[];
  category: string;
}
const { posts, category } = Astro.props;
---

<NotesLayout title={`分類：${category}`} description={describeNotes(`分類「${category}」`, posts)}>
  <NoteList {posts} title={`分類：${category}`} selectedCategory={category} />
</NotesLayout>
