---
import { getCollection, type CollectionEntry } from "astro:content";
import NotesLayout from "../../../layouts/NotesLayout.astro";
import NoteList from "../../../components/notes/NoteList.astro";
import { sortByDate } from "../../../lib/sortByDate";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const tags = new Map<string, string>();
  for (const post of posts) {
    for (const tag of post.data.tags ?? []) tags.set(tag.toLowerCase(), tag);
  }
  return [...tags].map(([slug, tag]) => ({
    params: { slug },
    props: {
      tag,
      posts: sortByDate(
        posts.filter((post) => (post.data.tags ?? []).some((name) => name.toLowerCase() === slug)),
      ),
    },
  }));
}

interface Props {
  posts: CollectionEntry<"blog">[];
  tag: string;
}
const { posts, tag } = Astro.props;
---

<NotesLayout title={`標籤：${tag}`}>
  <NoteList {posts} title={`標籤：${tag}`} />
</NotesLayout>
