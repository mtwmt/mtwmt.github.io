---
import NotesLayout from "../../../layouts/NotesLayout.astro";
import { ironman } from "../../../data/ironman";
import { notes } from "../../../data/notes";
---

<NotesLayout title={notes.series} description={notes.seriesDescription}>
  <h1 class="mb-10 border-b border-note-line pb-7 font-paper-serif text-3xl font-medium sm:text-4xl">
    {notes.series}
  </h1>
  <ul class="max-w-3xl">
    {ironman.map((series) => (
      <li class="grid grid-cols-[4rem_minmax(0,1fr)] gap-5 py-6 sm:grid-cols-[5rem_minmax(0,1fr)]">
        <span class="font-display text-2xl text-note-muted italic">{series.year}</span>
        <a
          href={series.href}
          class="border-l border-note-line pl-5 font-paper-serif text-lg leading-relaxed hover:text-note-accent"
        >
          {series.topic}
        </a>
      </li>
    ))}
  </ul>
</NotesLayout>
