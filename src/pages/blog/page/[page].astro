---
import type { GetStaticPathsOptions, Page } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import NotesLayout from "../../../layouts/NotesLayout.astro";
import NoteList from "../../../components/notes/NoteList.astro";
import Pagination from "../../../components/Pagination.astro";
import { notes } from "../../../data/notes";
import { sortByDate } from "../../../lib/sortByDate";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = sortByDate(await getCollection("blog")).filter(
    (post) => !(post.data.tags ?? []).some((tag) => /ironman/i.test(tag)),
  );
  return paginate(posts, { pageSize: notes.pageSize });
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
}
const { page } = Astro.props;
---

<NotesLayout
  title={page.currentPage === 1 ? notes.title : `${notes.title}（第 ${page.currentPage} 頁）`}
>
  <NoteList posts={page.data} title={notes.title}>
    <Pagination {page} />
  </NoteList>
</NotesLayout>
