---
import { getCollection, render, type CollectionEntry } from "astro:content";
import NotesLayout from "../../layouts/NotesLayout.astro";
import Tags from "../../components/Tags.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Toc from "../../components/Toc.astro";
import Comments from "../../components/Comments.astro";
import { notes } from "../../data/notes";
import { sortByDate } from "../../lib/sortByDate";
import { getNoteExcerpt } from "../../lib/notes";
import { getReadingTime } from "../../lib/readingtime";

export async function getStaticPaths() {
  const posts = sortByDate(await getCollection("blog"));
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, next: posts[index - 1], prev: posts[index + 1] },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
  prev?: CollectionEntry<"blog">;
}

const { post, next, prev } = Astro.props;
const { headings, Content } = await render(post);
const date = post.data.update ?? post.data.date;
const hasToc = headings.some((heading) => heading.depth === 2 || heading.depth === 3);
---

<NotesLayout
  title={post.data.title}
  description={getNoteExcerpt(post.body)}
  article={{ headline: post.data.title, published: post.data.date, modified: post.data.update }}
>
  <article>
    <a
      href="/blog/page/1/"
      class="mb-8 inline-flex min-h-11 items-center gap-2 text-sm text-note-muted hover:text-note-accent"
    >
      ← {notes.back}
    </a>
    <header class="mb-9 sm:mb-12">
      <Tags tags={post.data.tags} />
      <h1 class="mt-3 mb-6 font-paper-serif text-3xl leading-relaxed font-medium sm:text-4xl">
        {post.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-note-muted">
        <FormattedDate {date} type="note" />
        <span aria-hidden="true">·</span>
        <span>約 {getReadingTime(post.body)} 分鐘閱讀</span>
      </div>
    </header>
    <Toc {headings} mobile />
    <div
      class:list={[
        "grid items-start gap-12",
        hasToc ? "lg:grid-cols-[minmax(0,1fr)_200px] lg:gap-14" : "mx-auto max-w-3xl",
      ]}
    >
      <div class="min-w-0">
        <div
          data-note-body
          data-copy-label={notes.copy}
          data-copied-label={notes.copied}
          data-copy-failed-label={notes.copyFailed}
          class="note-prose"
        >
          <Content />
        </div>
        <nav
          aria-label="相鄰文章"
          class="mt-14 grid gap-6 border-t border-note-line pt-6 sm:grid-cols-2"
        >
          {prev && (
            <a href={`/blog/${prev.id}/`} class="text-sm leading-relaxed hover:text-note-accent">
              <span class="mb-2 block text-xs text-note-muted">← {notes.previous}</span>
              {prev.data.title}
            </a>
          )}
          {next && (
            <a
              href={`/blog/${next.id}/`}
              class="text-sm leading-relaxed hover:text-note-accent sm:col-start-2 sm:text-right"
            >
              <span class="mb-2 block text-xs text-note-muted">{notes.next} →</span>
              {next.data.title}
            </a>
          )}
        </nav>
        <section aria-label={notes.comments} class="mt-12 border-t border-note-line pt-7">
          <Comments />
        </section>
      </div>
      {hasToc && (
        <aside class="hidden self-stretch lg:block">
          <Toc {headings} />
        </aside>
      )}
    </div>
  </article>
</NotesLayout>

<script>
  function initNoteBody(): void {
    const body = document.querySelector<HTMLElement>("[data-note-body]");
    if (!body || body.dataset.initialized) return;
    body.dataset.initialized = "true";

    // 寬表格保留欄位寬度，由容器捲動；不讓整個手機頁面溢出。
    for (const table of body.querySelectorAll<HTMLTableElement>("table")) {
      const wrapper = document.createElement("div");
      wrapper.className = "my-7 max-w-full overflow-x-auto";
      wrapper.setAttribute("role", "region");
      wrapper.setAttribute("aria-label", "文章表格，可橫向捲動");
      wrapper.tabIndex = 0;
      table.before(wrapper);
      wrapper.append(table);
      table.className = "!my-0 !table min-w-[36rem]";
    }

    for (const link of body.querySelectorAll<HTMLAnchorElement>("a[href]")) {
      const url = new URL(link.href, location.href);
      if (url.origin !== location.origin && ["https:", "http:"].includes(url.protocol)) {
        link.target = "_blank";
        link.rel = "noopener noreferrer";
      }
    }

    for (const pre of body.querySelectorAll<HTMLPreElement>("pre")) {
      const code = pre.querySelector("code");
      if (!code) continue;
      const wrapper = document.createElement("div");
      wrapper.className = "relative min-w-0";
      pre.before(wrapper);
      wrapper.append(pre);
      pre.tabIndex = 0;
      const button = document.createElement("button");
      const label = body.dataset.copyLabel ?? "複製程式碼";
      button.type = "button";
      button.textContent = label;
      button.className =
        "absolute top-2 right-2 min-h-9 cursor-pointer rounded border border-note-line bg-note-soft px-3 py-1 text-xs text-note-muted hover:text-note-accent";
      button.setAttribute("aria-live", "polite");
      wrapper.append(button);

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? "");
          button.textContent = body.dataset.copiedLabel ?? "已複製";
        } catch {
          button.textContent = body.dataset.copyFailedLabel ?? "複製失敗，請重試";
        }
        window.setTimeout(() => {
          button.textContent = label;
        }, 1600);
      });
    }
  }

  document.addEventListener("astro:page-load", initNoteBody);
</script>
